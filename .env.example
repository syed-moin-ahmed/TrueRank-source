# Copy to .env (python scripts/init_env.py does this and fills in a random key). Never commit .env.

# Secret used to sign login tokens - at least 32 random characters.
JWT_SECRET_KEY=
JWT_EXPIRES_HOURS=12

# SQLite database file (relative to the TrueRank folder)
DATABASE_PATH=backend/instance/truerank.db

# Server
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

# Only needed if the frontend is served from a different origin (comma separated)
CORS_ORIGINS=

# --- TrueRank research parameters (defaults = values from the paper) ---
TRUERANK_WEIGHT_AR=0.40
TRUERANK_WEIGHT_CR=0.20
TRUERANK_WEIGHT_PE=0.20
TRUERANK_WEIGHT_DA=0.20
TRUERANK_LAMBDA=0.70

# --- Implementation parameters (documented in docs/ARCHITECTURE.md) ---
TRUERANK_MIN_SIMILARITY=0.05
TRUERANK_PE_CAP=20
TRUERANK_NEUTRAL_PRIOR=0.50
TRUERANK_INCLUDE_REVIEWS=true
TRUERANK_NGRAM_MAX=1
TRUERANK_TOP_N=10
